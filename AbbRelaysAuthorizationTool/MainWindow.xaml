<Window x:Class="AbbRelaysAuthorizationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ABB 继保离线选型授权工具"
        Width="980"
        Height="760"
        MinWidth="640"
        MinHeight="620"
        Icon="Assets/abb-relays-auth.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DEE8" />
            <Setter Property="Foreground" Value="#101828" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="48"
                    Height="48"
                    Background="#EAF2FF"
                    CornerRadius="12"
                    Margin="0,0,14,0">
                <materialDesign:PackIcon Kind="KeyVariant"
                                         Width="26"
                                         Height="26"
                                         Foreground="#1D4ED8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="ABB 继保离线选型授权工具"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#101828" />
                <TextBlock Text="导入软件生成的申请文件，签发加密激活文件。"
                           Margin="0,4,0,0"
                           Foreground="#64748B" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Button Click="ImportRequestButton_OnClick"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImportOutline" Width="18" Height="18" />
                            <TextBlock Text="导入申请文件" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="申请文件" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="RequestPathTextBlock"
                               Text="尚未导入"
                               Style="{StaticResource ValueStyle}" />

                    <TextBlock Text="机器名称" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="MachineNameTextBlock"
                               Text="-"
                               Style="{StaticResource ValueStyle}" />

                    <TextBlock Text="用户" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="UserNameTextBlock"
                               Text="-"
                               Style="{StaticResource ValueStyle}" />

                    <TextBlock Text="机器指纹" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="MachineIdTextBlock"
                               Text="-"
                               Style="{StaticResource ValueStyle}" />

                    <TextBlock Text="申请时间" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="CreatedAtTextBlock"
                               Text="-"
                               Style="{StaticResource ValueStyle}" />

                    <Border Background="#F8FAFC"
                            BorderBrush="#D8E0EA"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="签发流程"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#101828"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="1. 导入客户导出的 .zwreq 申请文件。&#x0a;2. 核对机器信息，填写授权对象和授权期限。&#x0a;3. 导出 .zwlic 激活文件并发回客户，由客户在主程序授权管理中导入。"
                                       TextWrapping="Wrap"
                                       LineHeight="21"
                                       Foreground="#344054" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="授权对象" Style="{StaticResource LabelStyle}" Margin="0,0,0,2" />
                    <TextBox x:Name="LicensedToTextBox"
                             MinHeight="36"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="客户或项目名称"
                             Padding="10,7"
                             BorderBrush="#D6DEE8" />

                    <CheckBox x:Name="PermanentCheckBox"
                              Content="永久授权"
                              IsChecked="True"
                              Margin="0,16,0,8"
                              Checked="PermanentCheckBox_OnChanged"
                              Unchecked="PermanentCheckBox_OnChanged" />

                    <TextBlock Text="到期日期" Style="{StaticResource LabelStyle}" />
                    <DatePicker x:Name="ExpiresDatePicker"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                IsEnabled="False"
                                SelectedDate="{x:Static sys:DateTime.Today}" />

                    <TextBlock Text="签发说明"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#101828"
                               Margin="0,28,0,8" />
                    <TextBlock Text="激活文件只适用于申请文件中的机器指纹。主程序导入时会校验文件加密封装、RSA 签名、机器指纹和有效期。"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="#344054" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,28,0,0"
                                HorizontalAlignment="Right">
                        <Button Click="ExportActivationButton_OnClick"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExportOutline" Width="18" Height="18" />
                                <TextBlock Text="导出激活文件" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Content="关闭"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                Click="CloseButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已授权设备记录"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#101828" />
                        <TextBlock x:Name="RecordFilePathTextBlock"
                                   Text="导出激活文件后会自动记录机器信息。"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="刷新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshRecordsButton_OnClick" />
                        <Button Content="打开记录目录"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                Click="OpenRecordFolderButton_OnClick" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="AuthorizationRecordsDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          MinHeight="180"
                          MaxHeight="280"
                          Background="White"
                          BorderBrush="#D8E0EA"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="机器名称" Binding="{Binding MachineName}" Width="130" />
                        <DataGridTextColumn Header="授权对象" Binding="{Binding LicensedTo}" Width="150" />
                        <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="150" />
                        <DataGridTextColumn Header="机器指纹" Binding="{Binding MachineIdShort}" Width="150" />
                        <DataGridTextColumn Header="签发时间" Binding="{Binding IssuedAtText}" Width="135" />
                        <DataGridTextColumn Header="有效期" Binding="{Binding ExpireText}" Width="90" />
                        <DataGridTextColumn Header="次数" Binding="{Binding IssueCount}" Width="60" />
                        <DataGridTextColumn Header="激活文件" Binding="{Binding ActivationFilePath}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
