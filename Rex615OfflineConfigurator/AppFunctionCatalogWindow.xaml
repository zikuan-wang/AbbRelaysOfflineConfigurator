<Window x:Class="Rex615OfflineConfigurator.AppFunctionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="APP 功能代码对照表"
        Width="1220"
        Height="700"
        MinWidth="920"
        MinHeight="520"
        Icon="Assets/rex615.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CatalogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellWrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>
    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ABB Code / ANSI Code 对照表"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="显示当前产品指南提取的 APP 保护功能、ANSI 代码、适用 APP 和来自 ABB 技术手册 Functionality 条目的保护原理摘要。"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CatalogTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索"
                         Width="220"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"
                         ToolTip="搜索 ABB Code、ANSI Code、中文或英文名称" />
                <ComboBox x:Name="VersionComboBox"
                          Grid.Column="2"
                          Style="{StaticResource CatalogComboBoxStyle}"
                          materialDesign:HintAssist.Hint="版本"
                          Width="92"
                          VerticalAlignment="Center"
                          SelectionChanged="VersionComboBox_OnSelectionChanged" />
                <Button Grid.Column="3"
                        Content="关闭"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="FunctionDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="58"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ABB Code" Binding="{Binding AbbCode}" Width="120" />
                    <DataGridTextColumn Header="ANSI Code" Binding="{Binding AnsiCode}" Width="130" />
                    <DataGridTextColumn Header="中文名称" Binding="{Binding ChineseName}" Width="190" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="English name" Binding="{Binding EnglishName}" Width="230" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="APP" Binding="{Binding Apps}" Width="150" />
                    <DataGridTextColumn Header="PCS" Binding="{Binding Pcs}" Width="60" />
                    <DataGridTemplateColumn Header="保护原理说明" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0,4">
                                    <TextBlock Text="{Binding PrincipleSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="#101828" />
                                    <TextBlock Text="{Binding FunctionalityCode, StringFormat=来源：ABB 技术手册 {0} Functionality}"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,3,0,0"
                                               ToolTip="{Binding SourceUrl}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
