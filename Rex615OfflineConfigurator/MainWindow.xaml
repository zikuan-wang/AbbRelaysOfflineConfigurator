<Window x:Class="Rex615OfflineConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Rex615OfflineConfigurator.ViewModels"
        xmlns:views="clr-namespace:Rex615OfflineConfigurator.Views"
        mc:Ignorable="d"
        Title="ABB REX615 离线选型工具"
        Width="1380"
        Height="900"
        MinWidth="1120"
        MinHeight="740"
        Icon="Assets/rex615.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Window.DataContext>
        <vm:ConfiguratorViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6DEE8" />
        <SolidColorBrush x:Key="SlotHeaderBrush" Color="#E8EDF3" />
        <SolidColorBrush x:Key="IoChipBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChipBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#101828" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="OptionRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAvailable}" Value="False" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.38" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="GroupSummaryStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ErrorBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlotColumnBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="SlotCodeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TargetChipButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SuggestionChipButtonStyle" TargetType="Button" BasedOn="{StaticResource TargetChipButtonStyle}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="HeaderNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="6"
                        Background="{StaticResource AccentBrush}"
                        Margin="0,0,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="ABB REX615 离线选型工具"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="组合代码生成 / 互斥校验 / 槽位分配"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding UseFullDescription, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              FontSize="13"
                              Foreground="{DynamicResource TextBrush}"
                              Content="显示完整描述" />
                    <Button Click="ConfiguratorPageButton_OnClick"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            ToolTip="REX615 选型">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18" />
                            <TextBlock Text="选型" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="CnLegacySelectionPageButton_OnClick"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            ToolTip="615/620 CN 装置选型">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListChecks" Width="18" Height="18" />
                            <TextBlock Text="615/620 CN 选型" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="LegacyConversionPageButton_OnClick"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            ToolTip="615/620 转换">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18" />
                            <TextBlock Text="615/620 转换" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="AboutLicensePageButton_OnClick"
                            Style="{StaticResource HeaderNavButtonStyle}"
                            ToolTip="授权管理与关于本工具">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyVariant" Width="18" Height="18" />
                            <TextBlock Text="授权/关于" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Margin="10"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0"
                    Style="{StaticResource ContentOnlyTabControlStyle}">
            <TabItem x:Name="ConfiguratorTabItem" Header="REX615 选型">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.52*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.18*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="LeftScrollViewer"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding MainGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <Border Style="{StaticResource ErrorBadgeStyle}"
                                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ErrorSummary}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectionMode}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource GroupSummaryStyle}">
                                                    <TextBlock Text="{Binding SelectedSummary, Mode=OneWay}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Options}" Margin="10,2,10,10">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource OptionRowBorderStyle}"
                                                            Width="300"
                                                            Margin="0,0,8,6">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  Style="{StaticResource OptionCheckBoxStyle}">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding DisplayDescription, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding OptionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="145" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <Border Style="{StaticResource ErrorBadgeStyle}"
                                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ErrorSummary}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectionMode}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource GroupSummaryStyle}">
                                                    <TextBlock Text="{Binding SelectedSummary, Mode=OneWay}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Options}" Margin="10,2,10,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource OptionRowBorderStyle}">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  Style="{StaticResource OptionCheckBoxStyle}">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding DisplayDescription, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RightScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="RightScrollViewer_OnPreviewMouseWheel">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Margin="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="组合代码"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCombinationValid}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="17"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCombinationValid}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <TextBox Text="{Binding FullCode, Mode=OneWay}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     TextWrapping="Wrap"
                                     Height="82"
                                     Margin="0,8,0,0"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     IsReadOnly="True"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Background="{DynamicResource FieldBackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Padding="10" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding ImportCodeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import" Width="18" Height="18" />
                                        <TextBlock Text="导入代码" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportOrderingNumberCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18" />
                                        <TextBlock Text="导入订货号" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" />
                                        <TextBlock Text="重置" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OnlineValidateCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudCheckOutline" Width="18" Height="18" />
                                        <TextBlock Text="在线校验" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowDeviceDescriptionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" />
                                        <TextBlock Text="装置描述" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CopyCodeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                        <TextBlock Text="复制代码" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Command="{Binding ExportWordCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileWordBox" Width="18" Height="18" />
                                        <TextBlock Text="导出 Word" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportExcelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcelBox" Width="18" Height="18" />
                                        <TextBlock Text="导出 Excel" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportPdfCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18" />
                                        <TextBlock Text="导出 PDF" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExpandAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="18" Height="18" />
                                        <TextBlock Text="展开" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CollapseAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="18" Height="18" />
                                        <TextBlock Text="折叠" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Border BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnlineValidationSuccess}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOnlineValidationError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <WrapPanel>
                                    <TextBlock Text="在线状态："
                                               Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding OnlineStatus}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,14,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnlineValidationSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
