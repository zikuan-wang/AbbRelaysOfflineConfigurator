<UserControl x:Class="Rex615OfflineConfigurator.Views.CnLegacySelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="LegacySelectorPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="LegacySelectorButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="LegacySelectorPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="LegacyTargetChipButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LegacyOptionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAvailable}" Value="False" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.45" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.52*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.18*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource LegacySelectorPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="选型规则"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="615 CN 5.0FP1 / 620 CN 2.0FP1 订货号选项"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right">
                        <Button Command="{Binding ExpandAllCommand}"
                                Style="{StaticResource LegacySelectorButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="18" Height="18" />
                                <TextBlock Text="全部展开" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CollapseAllCommand}"
                                Style="{StaticResource LegacySelectorButtonStyle}"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="18" Height="18" />
                                <TextBlock Text="全部折叠" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <ScrollViewer x:Name="SelectionScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Padding="0"
                                        Margin="0,0,0,8">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="6"
                                                        Padding="7,3"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Position, Mode=OneWay}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <Border Background="{DynamicResource DangerSoftBrush}"
                                                                BorderBrush="{DynamicResource DangerBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="7,1"
                                                                Margin="6,0,0,0"
                                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ErrorSummary}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectedSummary, Mode=OneWay}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Options}" Margin="10,0,10,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource LegacyOptionBorderStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,8,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Foreground="{DynamicResource TextBrush}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold" />
                                                                    <Run Text="：" />
                                                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ShortDescription, Mode=OneWay}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource LegacySelectorPanelStyle}"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="订货号"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Series}"
                                      SelectedItem="{Binding SelectedSeries, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="产品系列" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="装置类型" />
                        </Grid>

                        <TextBlock Text="{Binding DeviceDescription}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SourceDocumentsText}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <TextBox Text="{Binding OrderingCode, Mode=OneWay}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="True"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Margin="0,8,0,8"
                                 Padding="8"
                                 Background="{DynamicResource FieldBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}" />

                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding ImportOrderingCodeCommand}"
                                    Style="{StaticResource LegacySelectorButtonStyle}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="18" Height="18" />
                                    <TextBlock Text="导入" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowDeviceDescriptionCommand}"
                                    Style="{StaticResource LegacySelectorButtonStyle}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" />
                                    <TextBlock Text="装置描述" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PushToConversionCommand}"
                                    Style="{StaticResource LegacySelectorButtonStyle}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowRightBoldBoxOutline" Width="18" Height="18" />
                                    <TextBlock Text="推送到转换" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyOrderingCodeCommand}"
                                    Style="{StaticResource LegacySelectorPrimaryButtonStyle}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                    <TextBlock Text="复制订货号" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetCommand}"
                                    Style="{StaticResource LegacySelectorButtonStyle}"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restart" Width="18" Height="18" />
                                    <TextBlock Text="重置" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border CornerRadius="8"
                                Padding="10,7"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LegacySelectorPanelStyle}"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="I/O 摘要"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding IoSummaryItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource IoChipBackgroundBrush}"
                                                BorderBrush="{DynamicResource ChipBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="12,6"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Value}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="300"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LegacySelectorPanelStyle}"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="校验消息"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <ItemsControl ItemsSource="{Binding ValidationMessages}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonUp="ValidationMessage_OnClick"
                                            Background="{DynamicResource DangerSoftBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="8,6"
                                            Margin="0,0,0,6"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Targets}"
                                                          Margin="0,8,0,0"
                                                          Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="ValidationTarget_OnClick"
                                                                Style="{StaticResource LegacyTargetChipButtonStyle}"
                                                                Content="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="当前无离线校验错误。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LegacySelectorPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="当前选择"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <ScrollViewer MaxHeight="420"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SummaryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,6"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Position, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding GroupName, Mode=OneWay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0">
                                                        <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold" />
                                                        <Run Text="：" />
                                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
