<Window x:Class="AbbRelaysOfflineConfigurator.Rio600ModuleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="RIO600 模块详情"
        Width="980"
        Height="720"
        MinWidth="780"
        MinHeight="560"
        Icon="Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Background="#F3F6FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#D8E0EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Code}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="{Binding Name}"
                               Foreground="#475569"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#EAF2FF"
                        BorderBrush="#1D4ED8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="订货号"
                                   Foreground="#64748B"
                                   FontSize="12" />
                        <TextBlock Text="{Binding OrderNumber}"
                                   Foreground="#1D4ED8"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Background="White"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1">
            <TabItem Header="接线图">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFFFFF"
                            BorderBrush="#D8E0EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasConnectionImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Image Source="{Binding ConnectionImagePath}"
                                       Stretch="Uniform"
                                       MaxHeight="500"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ConnectionImageScaleTransform" ScaleX="1" ScaleY="1" />
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>
                            <Border Background="#F8FAFC"
                                    BorderBrush="#D8E0EA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectionImage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="LECM 通讯模块没有接线图。"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Text="接线图来自 RIO600 产品指南对应页面裁切。"
                               Foreground="#64748B"
                               Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="尺寸图">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFFFFF"
                            BorderBrush="#D8E0EA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding DimensionImagePath}"
                                   Stretch="Uniform"
                                   MaxHeight="500"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.LayoutTransform>
                                    <ScaleTransform x:Name="DimensionImageScaleTransform" ScaleX="1" ScaleY="1" />
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="尺寸图来自 RIO600 产品指南对应页面裁切。"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Dimensions.AppliesTo, StringFormat=适用模块：{0}}"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="缩小"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="ZoomOutButton_OnClick" />
            <Button Content="适应窗口"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="FitWindowButton_OnClick" />
            <TextBlock x:Name="ZoomTextBlock"
                       Width="58"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#475569"
                       Text="100%" />
            <Button Content="放大"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="ZoomInButton_OnClick" />
            <Button Content="关闭"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0"
                    Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
