<Window x:Class="AbbRelaysOfflineConfigurator.Rex615AccessoryCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="REX615 附件和额外项目"
        Width="1240"
        Height="680"
        MinWidth="1000"
        MinHeight="500"
        Icon="Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="AccessoryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="AccessoryTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="AccessoryComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="AccessoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="REX615 附件和额外项目 / Accessories and additional items"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="按分类、物料号、中文或英文描述搜索本地附件清单。Search by category, product code, Chinese or English description."
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="CategoryFilterComboBox"
                         Grid.Column="1"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                          Style="{StaticResource AccessoryComboBoxStyle}"
                          materialDesign:HintAssist.Hint="分类筛选 / Category"
                          SelectionChanged="CategoryFilterComboBox_OnSelectionChanged" />
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="2"
                         Style="{StaticResource AccessoryTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索 / Search"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged" />
                <Button Grid.Column="3"
                        Content="关闭 / Close"
                        Style="{StaticResource AccessoryButtonStyle}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="AccessoryDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="92"
                      RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="分类 / Category"
                                        Binding="{Binding CategoryDisplay}"
                                        Width="140"
                                        ElementStyle="{StaticResource AccessoryCellTextStyle}" />
                    <DataGridTextColumn Header="物料号 / Product"
                                        Binding="{Binding Product}"
                                        Width="138"
                                        ElementStyle="{StaticResource AccessoryCellTextStyle}" />
                    <DataGridTextColumn Header="中文描述 / Description CN"
                                        Binding="{Binding DescriptionZh}"
                                        Width="290"
                                        ElementStyle="{StaticResource AccessoryCellTextStyle}" />
                    <DataGridTextColumn Header="英文描述 / Description EN"
                                        Binding="{Binding Description}"
                                        Width="340"
                                        ElementStyle="{StaticResource AccessoryCellTextStyle}" />
                    <DataGridTextColumn Header="备注 / Note"
                                        Binding="{Binding AddDisplay}"
                                        Width="70"
                                        ElementStyle="{StaticResource AccessoryCellTextStyle}" />
                    <DataGridTemplateColumn Header="操作 / Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Button Tag="{Binding Product}"
                                            Style="{StaticResource AccessoryButtonStyle}"
                                            Margin="0,2,0,4"
                                            Click="CopyProductButton_OnClick">
                                        <StackPanel>
                                            <TextBlock Text="复制" HorizontalAlignment="Center" />
                                            <TextBlock Text="Copy" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{Binding Image}"
                                            Style="{StaticResource AccessoryButtonStyle}"
                                            IsEnabled="{Binding HasImage}"
                                            Click="OpenImageButton_OnClick">
                                        <StackPanel>
                                            <TextBlock Text="图片" HorizontalAlignment="Center" />
                                            <TextBlock Text="Image" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3"
                       Margin="0,10,0,0"
                       LastChildFill="False">
                <TextBlock x:Name="CountTextBlock"
                           DockPanel.Dock="Left"
                           Foreground="#64748B"
                           VerticalAlignment="Center" />
                <TextBlock Text="数据来源 / Source：REX615 Accessories and additional items.xlsx"
                           DockPanel.Dock="Right"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
