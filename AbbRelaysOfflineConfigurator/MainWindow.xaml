<Window x:Class="AbbRelaysOfflineConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AbbRelaysOfflineConfigurator.ViewModels"
        xmlns:views="clr-namespace:AbbRelaysOfflineConfigurator.Views"
        mc:Ignorable="d"
        Title="ABB 继保离线选型工具"
        Width="1380"
        Height="900"
        MinWidth="1120"
        MinHeight="740"
        Icon="Assets/abb-relays.ico"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Window.DataContext>
        <vm:ConfiguratorViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#D6DEE8" />
        <SolidColorBrush x:Key="SlotHeaderBrush" Color="#E8EDF3" />
        <SolidColorBrush x:Key="IoChipBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChipBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#018B8D" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F4F4" />
        <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#018B8D" />
        <SolidColorBrush x:Key="AppBarSearchBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppBarForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NavigationTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="NavigationIconBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextBrush" Color="#101828" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8E0EA" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D34947" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEEEE" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6ECC54" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#F1FBEE" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="OptionRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAvailable}" Value="False" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.38" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="GroupSummaryStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ErrorBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SlotColumnBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="SlotCodeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TargetChipButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SuggestionChipButtonStyle" TargetType="Button" BasedOn="{StaticResource TargetChipButtonStyle}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="HeaderNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="AppBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppBarForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AppBarTextButtonStyle" TargetType="Button" BasedOn="{StaticResource AppBarIconButtonStyle}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="NavigationMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="DrawerNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="DrawerNavigationTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <materialDesign:DrawerHost x:Name="RootDrawerHost">
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="328" Background="{DynamicResource CardBackgroundBrush}">
                <materialDesign:ColorZone DockPanel.Dock="Top"
                                          Mode="PrimaryMid"
                                          Background="{DynamicResource AppBarBackgroundBrush}"
                                          Foreground="{DynamicResource AppBarForegroundBrush}"
                                          Padding="22,20">
                    <StackPanel>
                        <TextBlock x:Name="DrawerTitleTextBlock"
                                   Text="ABB 继保离线选型工具"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DrawerSubtitleTextBlock"
                                   Text="页面导航"
                                   FontSize="12"
                                   Opacity="0.78"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </materialDesign:ColorZone>

                <StackPanel Margin="8,12">
                    <Button Click="HomePageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavHomeTextBlock" Text="首页" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="ConfiguratorPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavRex615TextBlock" Text="REX615 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Rex640SelectionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavRex640TextBlock" Text="REX640 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Rio600SelectionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewModuleOutline" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavRio600TextBlock" Text="RIO600 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Ssc600SelectionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavSsc600TextBlock" Text="SSC600 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="Rex600SelectionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Memory" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavRex600TextBlock" Text="REX600 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,10" />
                    <Button Click="CnLegacySelectionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListChecks" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavCnLegacyTextBlock" Text="615/620 CN 选型" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Click="LegacyConversionPageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavLegacyConversionTextBlock" Text="615/620 转换" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,10" />
                    <Button Click="AboutLicensePageButton_OnClick"
                            Style="{StaticResource DrawerNavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyVariant" Width="22" Height="22" Foreground="{DynamicResource NavigationIconBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavAboutTextBlock" Text="授权 / 关于 / 更新" Style="{StaticResource DrawerNavigationTextStyle}" Margin="16,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <DockPanel LastChildFill="True">
            <materialDesign:ColorZone DockPanel.Dock="Top"
                                      Mode="PrimaryMid"
                                      Background="{DynamicResource AppBarBackgroundBrush}"
                                      Foreground="{DynamicResource AppBarForegroundBrush}"
                                      Padding="12,0"
                                      Height="64"
                                      materialDesign:ElevationAssist.Elevation="Dp4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Click="NavigationMenuButton_OnClick"
                            Style="{StaticResource MaterialDesignToolButton}"
                            Foreground="{DynamicResource AppBarForegroundBrush}"
                            x:Name="NavigationMenuButton"
                            ToolTip="页面导航"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Menu" Width="26" Height="26" Foreground="{DynamicResource AppBarForegroundBrush}" />
                    </Button>

                    <TextBlock x:Name="TopBarTitleTextBlock"
                               Grid.Column="1"
                               Text="ABB 继保离线选型工具"
                               FontSize="20"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AppBarForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,28,0" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                 Foreground="{DynamicResource AppBarForegroundBrush}"
                                                 x:Name="SettingsPopupBox"
                                                 ToolTip="设置">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24" Foreground="{DynamicResource AppBarForegroundBrush}" />
                            </materialDesign:PopupBox.ToggleContent>
                            <StackPanel Width="420" Margin="16">
                                <TextBlock x:Name="SettingsTitleTextBlock"
                                           Text="界面设置"
                                           FontSize="16"
                                           FontWeight="Medium" />
                                <CheckBox x:Name="UseFullDescriptionCheckBox"
                                          IsChecked="{Binding UseFullDescription, Mode=TwoWay}"
                                          Content="显示完整描述"
                                          Margin="0,14,0,12" />
                                <TextBlock x:Name="DisplayLanguageLabelTextBlock"
                                           Text="显示语言"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.72"
                                           Margin="0,0,0,8" />
                                <ComboBox x:Name="DisplayLanguageComboBox"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource MaterialDesignFilledComboBox}"
                                          materialDesign:HintAssist.Hint="Language"
                                          Margin="0,0,0,14"
                                          SelectionChanged="DisplayLanguageComboBox_OnSelectionChanged">
                                    <ComboBoxItem x:Name="ChineseLanguageComboBoxItem" Tag="zh-CN" Content="中文" />
                                    <ComboBoxItem x:Name="EnglishLanguageComboBoxItem" Tag="en-US" Content="English" />
                                </ComboBox>
                                <TextBlock x:Name="ThemeColorLabelTextBlock"
                                           Text="主题颜色"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.72"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="-4,0,-4,0">
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#6ECC54"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#6ECC54" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeLimeGreenTextBlock" Text="莱姆绿" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#D34947"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#D34947" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeTitianRedTextBlock" Text="提香红" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#018B8D"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#018B8D" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeMarsGreenTextBlock" Text="马尔斯绿" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#002FA7"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#002FA7" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeKleinBlueTextBlock" Text="克莱因蓝" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#470125"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#470125" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeBurgundyTextBlock" Text="勃艮第" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#F9D46C"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#F9D46C" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeSchonbrunnYellowTextBlock" Text="申布伦黄" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#71E2D1"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#71E2D1" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeTiffanyBlueTextBlock" Text="蒂芙尼蓝" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#C8161D"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#C8161D" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeChineseRedTextBlock" Text="中国红" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#492D22"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#492D22" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeVanDyckBrownTextBlock" Text="凡戴克棕" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#EB5C20"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="#EB5C20" CornerRadius="7" />
                                            <TextBlock x:Name="ThemeHermesOrangeTextBlock" Text="爱马仕橙" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ThemeColorButton_OnClick"
                                            Tag="#0D3A69"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,4,0">
