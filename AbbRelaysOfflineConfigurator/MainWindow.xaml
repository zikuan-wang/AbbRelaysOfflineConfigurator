                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46"
                                            Height="46"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10"
                                            Margin="0,0,14,0">
                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Width="25"
                                                                 Height="25"
                                                                 Foreground="{DynamicResource AccentBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="ABB 继保离线选型工具"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock x:Name="AboutVersionTextBlock"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="工具说明"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,20,0,8" />
                                <TextBlock Text="本工具基于本地数据包进行 ABB 继保产品离线选型、互斥校验、槽位分配、I/O 摘要统计、组合代码生成、SSC600/SSC600 SW 订货码生成、615/620 CN 选型、旧订货号转换、RIO600/REX640 选型，以及在线校验订货号。"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Foreground="{DynamicResource TextBrush}" />

                                <TextBlock Text="在线更新"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,8" />
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="更新源固定为 GitHub Releases：zikuan-wang/AbbRelaysOfflineConfigurator_Release。"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock x:Name="UpdateStatusTextBlock"
                                                   Text="尚未检查更新。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="CheckUpdateButton"
                                                    Click="CheckUpdateButton_OnClick"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinHeight="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CloudSyncOutline" Width="18" Height="18" />
                                                    <TextBlock Text="检查更新" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="OpenUpdateReleaseButton"
                                                    Click="OpenUpdateReleaseButton_OnClick"
                                                    IsEnabled="False"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" />
                                                    <TextBlock Text="打开发布页" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="DownloadInstallUpdateButton"
                                                    Click="DownloadInstallUpdateButton_OnClick"
                                                    IsEnabled="False"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DownloadBoxOutline" Width="18" Height="18" />
                                                    <TextBlock Text="下载并安装" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="版权信息"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,8" />
                                <TextBlock Text="版权属于 zikuan wang。ABB、REX615、REX640、SSC600、RIO600 及相关产品名称归其权利人所有。本工具仅在本地实现选型辅助和组合代码生成，不复制 ABB 官方在线配置器页面或受版权保护的表现形式。"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Foreground="{DynamicResource TextBrush}" />

                                <TextBlock Text="免责声明"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,18,0,8" />
                                <TextBlock Text="本工具仅作为离线选型和组合代码校验辅助，不构成 ABB 官方报价、订货确认、工程设计结论或技术承诺。最终型号、订货号、价格、交期和技术适用性应以 ABB 官方资料、在线校验结果及正式商务文件为准，使用者需自行复核。"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="Rex600TabItem" Header="REX600 选型">
                <views:Rex600SelectorView DataContext="{Binding Rex600Selection}" />
            </TabItem>
            <TabItem x:Name="Rex640TabItem" Header="REX640 选型">
                <views:Rex640SelectorView DataContext="{Binding Rex640Selection}" />
            </TabItem>
        </TabControl>
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
