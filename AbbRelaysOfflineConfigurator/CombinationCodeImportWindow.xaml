<Window x:Class="AbbRelaysOfflineConfigurator.CombinationCodeImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="导入组合代码"
        Width="720"
        Height="360"
        MinWidth="560"
        MinHeight="300"
        Icon="pack://application:,,,/AbbRelaysOfflineConfigurator;component/Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogPrimaryButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="TitleTextBlock"
                       Text="导入组合代码"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionTextBlock"
                       Text="主代码必须在开头，后续选项代码可乱序，用 + 分隔。"
                       Foreground="#646464"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TextBox x:Name="CodeTextBox"
                 Grid.Row="1"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="REX615A10GN+APP1+..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="10"
                 BorderBrush="#C8CED8"
                 Background="White" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ImportButton"
                    Content="导入"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Click="ImportButton_OnClick" />
            <Button Content="取消"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
