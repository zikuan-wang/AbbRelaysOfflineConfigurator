<UserControl x:Class="AbbRelaysOfflineConfigurator.Views.Rex640SelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="Rex640PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Rex640OptionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAvailable}" Value="False" />
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.38" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Rex640ButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rex640SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rex640PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rex640DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rex640TargetChipButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Rex640SuggestionChipButtonStyle" TargetType="Button" BasedOn="{StaticResource Rex640TargetChipButtonStyle}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Rex640ToolbarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rex640SlotColumnStyle" TargetType="Border">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="326" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>
        <Style x:Key="Rex640SlotCodeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.52*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.18*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Rex640PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding SourceSummary}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Command="{Binding ExpandAllCommand}"
                                Style="{StaticResource Rex640ButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="18" Height="18" />
                                <TextBlock Text="{Binding ExpandAllText}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CollapseAllCommand}"
                                Style="{StaticResource Rex640ButtonStyle}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="UnfoldLessHorizontal" Width="18" Height="18" />
                                <TextBlock Text="{Binding CollapseAllText}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <ScrollViewer x:Name="SelectionScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Rex640PanelStyle}"
                                        Padding="0"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <Border Background="{DynamicResource DangerSoftBrush}"
                                                                BorderBrush="{DynamicResource DangerBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="7,1"
                                                                Margin="6,0,0,0"
                                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ErrorSummary}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DangerBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectionMode}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding SelectedSummary}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Options}" Margin="10,2,10,10">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="330"
                                                            Style="{StaticResource Rex640OptionBorderStyle}"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanToggle}"
                                                                  VerticalContentAlignment="Center"
                                                                  Foreground="{DynamicResource TextBrush}">
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding Description, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Rex640PanelStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OrderCodeTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="16"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        <TextBox Text="{Binding OrderCode, Mode=OneWay}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap"
                                 Height="76"
                                 Margin="0,8,0,0"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 IsReadOnly="True"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 Background="{DynamicResource FieldBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Padding="10" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding ImportOrderCodeCommand}" Style="{StaticResource Rex640ButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="18" Height="18" />
                                    <TextBlock Text="{Binding ImportOrderCodeText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetCommand}" Style="{StaticResource Rex640DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" />
                                    <TextBlock Text="{Binding ResetText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OnlineValidateCommand}" Style="{StaticResource Rex640PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudCheckOutline" Width="18" Height="18" />
                                    <TextBlock Text="{Binding OnlineValidateText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowDeviceDescriptionCommand}" Style="{StaticResource Rex640ButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" />
                                    <TextBlock Text="{Binding DeviceDescriptionText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyOrderCodeCommand}" Style="{StaticResource Rex640ButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                    <TextBlock Text="{Binding CopyOrderCodeText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Border BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnlineValidationSuccess}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOnlineValidationError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel>
                                <TextBlock Text="{Binding OnlineStatusLabel}"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding OnlineStatus}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,14,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnlineValidationSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnlineValidationError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding OrderingNumberLabel}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Visibility="{Binding HasOnlineOrderingNumber, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding OnlineOrderingNumber}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,8,0"
                                           Visibility="{Binding HasOnlineOrderingNumber, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Command="{Binding CopyOrderingNumberCommand}"
                                        Style="{StaticResource Rex640TargetChipButtonStyle}"
                                        Padding="8,2"
                                        Margin="0"
                                        Visibility="{Binding HasOnlineOrderingNumber, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                                        <TextBlock Text="{Binding CopyText}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rex640PanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding AppRecommendationTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding AppRecommendationSummary}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AppRecommendationVersions}"
                                      SelectedItem="{Binding AppRecommendationVersion, Mode=TwoWay}"
                                      Style="{StaticResource Rex640ToolbarComboBoxStyle}"
                                      materialDesign:HintAssist.Hint="{Binding AppRecommendationVersionText}"
                                      Margin="8,0,8,0"
                                      VerticalAlignment="Top" />
                            <Button Grid.Column="2"
                                    Click="Rex640FunctionCatalogButton_OnClick"
                                    Style="{StaticResource Rex640SecondaryButtonStyle}"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableSearch" Width="18" Height="18" />
                                    <TextBlock Text="{Binding FunctionCatalogShortText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding AddFunctionInputCommand}"
                                    Style="{StaticResource Rex640PrimaryButtonStyle}"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="18" Height="18" />
                                    <TextBlock Text="{Binding RecommendFunctionText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding FunctionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="{Binding FunctionInputHint}"
                                     MinHeight="32"
                                     Padding="8,6"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     Background="{DynamicResource FieldBackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding AddFunctionInputCommand}"
                                    Style="{StaticResource Rex640SecondaryButtonStyle}"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                                    <TextBlock Text="{Binding AddFunctionText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding FunctionSuggestions}"
                                      Visibility="{Binding HasFunctionSuggestions, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding AddCommand}"
                                            Style="{StaticResource Rex640SuggestionChipButtonStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding EnglishName}"
                                                       FontSize="11"
                                                       LineHeight="15"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding RequestedFunctions}"
                                      Visibility="{Binding HasRequestedFunctions, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CodeWithAnsi}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding SecondaryName}"
                                                       Margin="8,0,0,0"
                                                       MaxWidth="260"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <Button Command="{Binding RemoveCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4"
                                                    MinWidth="26"
                                                    Width="26"
                                                    Height="26"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    Margin="6,0,0,0"
                                                    ToolTip="移除">
                                                <materialDesign:PackIcon Kind="Close"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding AppRecommendations}"
                                      Visibility="{Binding HasAppRecommendations, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource ChipBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,7"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding CoveredFunctionsText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding ApplyRecommendedAppsCommand}"
                                    Style="{StaticResource Rex640PrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding HasAppRecommendations, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SendCheckOutline" Width="18" Height="18" />
                                    <TextBlock Text="{Binding PushRecommendedAppsText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearFunctionRecommendationCommand}"
                                    Style="{StaticResource Rex640SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BackspaceOutline" Width="18" Height="18" />
                                    <TextBlock Text="{Binding ClearFunctionsText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rex640PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding IoSummaryTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding IoSummaryItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource IoChipBackgroundBrush}"
                                                BorderBrush="{DynamicResource ChipBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="12,6"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Value}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           MaxWidth="300"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rex640PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ValidationMessagesTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonUp="ValidationMessage_OnClick"
                                            CornerRadius="7"
                                            Padding="9,6"
                                            Margin="0,0,0,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Targets}"
                                                          Margin="0,8,0,0"
                                                          Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="ValidationTarget_OnClick"
                                                                Style="{StaticResource Rex640ButtonStyle}"
                                                                Content="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Rex640PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding SlotAllocationTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Margin="0,10,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Rex640SlotColumnStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="34" />
                                                        <RowDefinition Height="36" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{DynamicResource SlotHeaderBrush}"
                                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <TextBlock Text="{Binding SlotId, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                    </Border>
                                                    <Border Grid.Row="1"
                                                            Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Button Click="SlotCode_OnClick"
                                                                IsEnabled="{Binding CanJump}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Cursor="Hand"
                                                                ToolTip="跳转到对应选项">
                                                            <TextBlock Text="{Binding Code, Mode=OneWay}"
                                                                       Style="{StaticResource Rex640SlotCodeTextStyle}" />
                                                        </Button>
                                                    </Border>
                                                    <Grid Grid.Row="2"
                                                          Background="{DynamicResource SurfaceBrush}"
                                                          ClipToBounds="True">
                                                        <Border MouseLeftButtonUp="SlotDiagram_OnClick"
                                                                Background="Transparent"
                                                                Cursor="Hand"
                                                                ToolTip="{Binding TerminalDiagramToolTip}">
                                                            <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                                       Width="232"
                                                                       Margin="0,0,0,12"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap"
                                                                       LineStackingStrategy="BlockLineHeight"
                                                                       LineHeight="18"
                                                                       ToolTip="{Binding Description, Mode=OneWay}">
                                                                <TextBlock.LayoutTransform>
                                                                    <RotateTransform Angle="-90" />
                                                                </TextBlock.LayoutTransform>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
