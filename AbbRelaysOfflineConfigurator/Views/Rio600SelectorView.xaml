<UserControl x:Class="AbbRelaysOfflineConfigurator.Views.Rio600SelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="RioPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="RioComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="RioButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RioDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RioSlotCardStyle" TargetType="Border">
            <Setter Property="Height" Value="174" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderBrush" Value="#AAB4C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource RioPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="选型规则"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="模块类型" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="硬件类型" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="模块版本" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding ModuleOptions}"
                                                      SelectedItem="{Binding SelectedModuleOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding IsModuleEnabled}"
                                                      Style="{StaticResource RioComboBoxStyle}"
                                                      Margin="0,0,10,0" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding HardwareOptions}"
                                                      SelectedItem="{Binding SelectedHardwareOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding IsHardwareEnabled}"
                                                      Style="{StaticResource RioComboBoxStyle}"
                                                      Margin="0,0,10,0" />
                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{Binding SoftwareOptions}"
                                                      SelectedItem="{Binding SelectedSoftwareOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding IsVersionEnabled}"
                                                      Style="{StaticResource RioComboBoxStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,10">
                            <TextBlock Text="{Binding ConfigurationSummary}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource RioPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="RIO600 模块订货清单"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="RIO600 不使用整机订货码，按下列模块订货号和数量订货。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,8,0,0"
                                ClipToBounds="True">
                            <StackPanel>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="136" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模块" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Column="1" Text="描述" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Column="2" Text="订货号" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Column="3" Text="数量" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding OrderListItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="8,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="136" />
                                                        <ColumnDefinition Width="46" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ModuleCode}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Margin="6,0" />
                                                    <DockPanel Grid.Column="2"
                                                               LastChildFill="True"
                                                               VerticalAlignment="Center">
                                                        <Button DockPanel.Dock="Right"
                                                                Tag="{Binding OrderNumber}"
                                                                Click="CopyModuleOrderNumberButton_OnClick"
                                                                Width="28"
                                                                Height="26"
                                                                Padding="0"
                                                                ToolTip="复制订货号"
                                                                Style="{StaticResource MaterialDesignIconButton}">
                                                            <materialDesign:PackIcon Kind="ContentCopy"
                                                                                     Width="15"
                                                                                     Height="15" />
                                                        </Button>
                                                        <TextBlock Text="{Binding OrderNumber}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding QuantityText}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding ResetCommand}" Style="{StaticResource RioDangerButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" />
                                    <TextBlock Text="重置" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowDeviceDescriptionCommand}" Style="{StaticResource RioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" />
                                    <TextBlock Text="装置描述" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyOrderCodeCommand}" Style="{StaticResource RioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                                    <TextBlock Text="复制订货清单" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource RioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelBox" Width="18" Height="18" />
                                    <TextBlock Text="导出 Excel" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Click="FunctionCatalogButton_OnClick" Style="{StaticResource RioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableSearch" Width="18" Height="18" />
                                    <TextBlock Text="功能清单" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Border CornerRadius="8"
                                Padding="10,7"
                                Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="15"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RioPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="槽位分配"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AssemblyWidthText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border BorderBrush="#D8E0EA"
                                BorderThickness="1"
                                Background="#FFFFFF"
                                CornerRadius="7"
                                Margin="0,10,0,0"
                                Padding="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12"
                                            Height="174"
                                            Background="#CBD5E1"
                                            BorderBrush="#94A3B8"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Margin="0,0,2,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedModules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding VisualWidth}"
                                                        Tag="{Binding DetailKey}"
                                                        Style="{StaticResource RioSlotCardStyle}"
                                                        ToolTip="查看接线图和尺寸图"
                                                        MouseLeftButtonUp="ModuleDetailCard_OnMouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="30" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#E8EEF6"
                                                                BorderBrush="#D8E0EA"
                                                                BorderThickness="0,0,0,1">
                                                            <TextBlock Text="{Binding ModuleCode}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Row="1"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="4">
                                                            <TextBlock Text="{Binding SlotName}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Foreground="#64748B" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       MaxWidth="105"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding OrderNumber}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#1D4ED8"
                                                                       MaxWidth="105"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                        <Grid Grid.Row="2" Margin="4,0,4,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding WidthText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="#64748B" />
                                                            <Button Grid.Column="1"
                                                                    Tag="{Binding OrderNumber}"
                                                                    Click="CopyModuleOrderNumberButton_OnClick"
                                                                    Width="26"
                                                                    Height="24"
                                                                    Padding="0"
                                                                    ToolTip="复制订货号"
                                                                    Style="{StaticResource MaterialDesignIconButton}">
                                                                <materialDesign:PackIcon Kind="ContentCopy"
                                                                                         Width="15"
                                                                                         Height="15" />
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="12"
                                            Height="174"
                                            Background="#CBD5E1"
                                            BorderBrush="#94A3B8"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Margin="2,0,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RioPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="I/O 摘要"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <ItemsControl ItemsSource="{Binding IoSummaryItems}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RioPanelStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="校验消息"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="校验通过"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource DangerSoftBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,6"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
