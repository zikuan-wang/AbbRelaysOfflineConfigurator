<UserControl x:Class="AbbRelaysOfflineConfigurator.Views.LegacyConversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="13">
    <UserControl.Resources>
        <Style x:Key="LegacyPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="LegacyButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="LegacyPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="InlineCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="ToolTip" Value="复制" />
        </Style>
        <Style x:Key="ResultCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LegacyPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="615/620 系列订货号转换"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="离线使用软件内置转换规则并自动判断装置类型；勾选在线转换时直接调用 ABB ConvertCode 接口。"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedBrush}" />

                    <TextBlock Text="装置类型"
                               Margin="0,12,0,4"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6">
                        <TextBlock Text="自动判断 615/620 装置类型"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>

                    <CheckBox Content="在线转换 615/620 订货号"
                              IsChecked="{Binding UseOnlineConversion, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip="不支持 CN 产品"
                              Margin="0,10,0,0"
                              Foreground="{DynamicResource TextBrush}" />

                    <TextBlock Text="{Binding Status}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="615/620 订货号"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBox Text="{Binding InputCodes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Height="108"
                             Margin="0,5,0,8"
                             Padding="8"
                             IsEnabled="{Binding CanEdit}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"
                             Background="{DynamicResource FieldBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}" />

                    <WrapPanel>
                        <Button Command="{Binding ConvertCommand}"
                                Style="{StaticResource LegacyPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18" />
                                <TextBlock Text="转换并在线校验" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}"
                                Style="{StaticResource LegacyButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelBox" Width="18" Height="18" />
                                <TextBlock Text="导出清单" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCommand}"
                                Style="{StaticResource LegacyButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BackspaceOutline" Width="18" Height="18" />
                                <TextBlock Text="清空" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource LegacyPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="转换结果"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultSummary}"
                               Foreground="{DynamicResource MutedBrush}" />
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource PanelBorderBrush}"
                          Foreground="{DynamicResource TextBrush}">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="615/620订货号" Binding="{Binding SourceOrderingCode}" Width="170" ElementStyle="{StaticResource ResultCellTextStyle}" />
                        <DataGridTextColumn Header="装置类型" Binding="{Binding DeviceType}" Width="190" ElementStyle="{StaticResource ResultCellTextStyle}" />
                        <DataGridTextColumn Header="方式" Binding="{Binding ConversionMode}" Width="100" ElementStyle="{StaticResource ResultCellTextStyle}" />
                        <DataGridTemplateColumn Header="REX615组合代码" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CompositionCode}"
                                                   Style="{StaticResource ResultCellTextStyle}" />
                                        <Button Grid.Column="1"
                                                Command="{Binding CopyCompositionCodeCommand}"
                                                Style="{StaticResource InlineCopyButtonStyle}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="REX615订货号" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RexOrderingNumber}"
                                                   Style="{StaticResource ResultCellTextStyle}" />
                                        <Button Grid.Column="1"
                                                Command="{Binding CopyRexOrderingNumberCommand}"
                                                Style="{StaticResource InlineCopyButtonStyle}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="230" ElementStyle="{StaticResource ResultCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
