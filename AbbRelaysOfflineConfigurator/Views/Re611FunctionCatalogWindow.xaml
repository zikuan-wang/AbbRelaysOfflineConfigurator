<Window x:Class="AbbRelaysOfflineConfigurator.Views.Re611FunctionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="RE_611 保护功能清单"
        Width="1240"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        Icon="pack://application:,,,/AbbRelaysOfflineConfigurator;component/Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CatalogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellWrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RE_611 保护功能清单"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="按 REB611 / REF611 / REM611 / REU611 和产品版本区分标准配置、保护功能、IEC 61850 与 ANSI Code。"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CatalogTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索"
                         Width="220"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged" />
                <ComboBox x:Name="DeviceComboBox"
                          Grid.Column="2"
                          Style="{StaticResource CatalogComboBoxStyle}"
                          materialDesign:HintAssist.Hint="装置"
                          Width="130"
                          VerticalAlignment="Center"
                          SelectionChanged="FilterComboBox_OnSelectionChanged" />
                <ComboBox x:Name="VersionComboBox"
                          Grid.Column="3"
                          Style="{StaticResource CatalogComboBoxStyle}"
                          materialDesign:HintAssist.Hint="版本"
                          Width="120"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          SelectionChanged="FilterComboBox_OnSelectionChanged" />
                <Button Grid.Column="4"
                        Content="Export Excel"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="ExportExcelButton_OnClick" />
                <Button Grid.Column="5"
                        Content="关闭"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="FunctionDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="58"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="产品" Binding="{Binding DeviceId}" Width="90" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="版本" Binding="{Binding ProductVersion}" Width="80" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="标准配置" Binding="{Binding Configurations}" Width="150" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="86" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="IEC 61850" Binding="{Binding Iec61850}" Width="130" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="ANSI Code" Binding="{Binding AnsiCode}" Width="130" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="中文名称" Binding="{Binding ChineseName}" Width="260" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="English name" Binding="{Binding EnglishName}" Width="260" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="来源页" Binding="{Binding SourcePage}" Width="76" ElementStyle="{StaticResource CellWrapTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
