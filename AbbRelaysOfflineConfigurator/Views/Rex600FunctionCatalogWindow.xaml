<Window x:Class="AbbRelaysOfflineConfigurator.Views.Rex600FunctionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="REX600 功能清单"
        Width="1120"
        Height="680"
        MinWidth="900"
        MinHeight="520"
        Icon="/Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellWrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="REX600 功能清单"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="来源：REX600 产品指南 2NGA002882 ENa，第 20 节 Functions, codes and symbols。"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CatalogTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索"
                         Width="240"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"
                         ToolTip="搜索类别、功能名称、IEC 61850、IEC 60617 或 ANSI Code" />
                <Button Grid.Column="2"
                        Content="关闭"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="FunctionDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="56"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="130" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="中文名称" Binding="{Binding ChineseName}" Width="260" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="English name" Binding="{Binding EnglishName}" Width="300" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="IEC 61850" Binding="{Binding Iec61850}" Width="130" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="IEC 60617" Binding="{Binding Iec60617}" Width="120" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="ANSI Code" Binding="{Binding AnsiCode}" Width="120" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="页码" Binding="{Binding SourcePage}" Width="70" ElementStyle="{StaticResource CellWrapTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
