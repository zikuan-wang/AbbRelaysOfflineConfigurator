<Window x:Class="AbbRelaysOfflineConfigurator.Views.Re630FunctionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="RE_630 功能代码对照表"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="540"
        Icon="pack://application:,,,/AbbRelaysOfflineConfigurator;component/Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CatalogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellWrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RE_630 IEC 61850 / ANSI Code 对照表"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="显示 REF630、REG630、REM630、RET630 产品指南中 Functions, codes and symbols 表格提取的功能代码。"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CatalogTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索"
                         Width="220"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"
                         ToolTip="搜索装置、分类、IEC 61850、IEC 60617、ANSI Code 或功能描述" />
                <ComboBox x:Name="DeviceComboBox"
                          Grid.Column="2"
                          Style="{StaticResource CatalogComboBoxStyle}"
                          materialDesign:HintAssist.Hint="装置"
                          Width="112"
                          VerticalAlignment="Center"
                          SelectionChanged="DeviceComboBox_OnSelectionChanged" />
                <Button Grid.Column="3"
                        Content="关闭"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="FunctionDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="46"
                      RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="装置" Binding="{Binding Device}" Width="82" MinWidth="74" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="145" MinWidth="120" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="IEC 61850" Binding="{Binding Iec61850}" Width="130" MinWidth="110" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="IEC 60617" Binding="{Binding Iec60617}" Width="130" MinWidth="110" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="ANSI Code" Binding="{Binding Ansi}" Width="130" MinWidth="110" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" MinWidth="260" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTemplateColumn Header="来源" Width="1.2*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="0,4">
                                    <TextBlock Text="{Binding Source}"
                                               TextWrapping="Wrap"
                                               Foreground="#101828" />
                                    <TextBlock Text="{Binding PageText}"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
