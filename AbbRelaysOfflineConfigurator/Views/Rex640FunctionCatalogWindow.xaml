<Window x:Class="AbbRelaysOfflineConfigurator.Views.Rex640FunctionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="REX640 APP 功能代码对照表"
        Width="1180"
        Height="720"
        MinWidth="880"
        MinHeight="540"
        Icon="/Assets/abb-relays.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="#F3F6FA">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDialogOutlinedButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CatalogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellWrapTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#D8E0EA"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="REX640 ABB Code / ANSI Code 对照表"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="显示 REX640 PCL5/PCL6 产品指南中提取的基础功能和 APP 功能清单。"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CatalogTextBoxStyle}"
                         materialDesign:HintAssist.Hint="搜索"
                         Width="220"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"
                         ToolTip="搜索 PCL、APP、ABB Code、ANSI Code、中文或英文名称" />
                <ComboBox x:Name="VersionComboBox"
                          Grid.Column="2"
                          Style="{StaticResource CatalogComboBoxStyle}"
                          materialDesign:HintAssist.Hint="PCL"
                          Width="96"
                          VerticalAlignment="Center"
                          SelectionChanged="VersionComboBox_OnSelectionChanged" />
                <Button Grid.Column="3"
                        Content="关闭"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="8,0,0,0"
                        Click="CloseButton_OnClick" />
            </Grid>

            <DataGrid x:Name="FunctionDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MinRowHeight="58"
                      RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#D8E0EA"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PCL" Binding="{Binding Pcl}" Width="62" MinWidth="54" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="92" MinWidth="82" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="ABB Code" Binding="{Binding AbbCode}" Width="112" MinWidth="96" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="ANSI Code" Binding="{Binding AnsiCode}" Width="116" MinWidth="96" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="中文名称" Binding="{Binding ChineseName}" Width="1.1*" MinWidth="150" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="English name" Binding="{Binding EnglishName}" Width="1.3*" MinWidth="170" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="APP/基础功能" Binding="{Binding Apps}" Width="112" MinWidth="96" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTextColumn Header="PCS" Binding="{Binding Pcs}" Width="52" MinWidth="48" ElementStyle="{StaticResource CellWrapTextStyle}" />
                    <DataGridTemplateColumn Header="说明" Width="1.6*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0,4">
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="#101828" />
                                    <TextBlock Text="{Binding SourceText}"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
